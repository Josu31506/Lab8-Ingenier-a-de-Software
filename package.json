{
  "name": "rewards-system",
  "version": "1.0.0",
  "description": "Event-driven restaurant rewards backend with Node.js, Express and RabbitMQ.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "lint": "eslint src tests"
  },
  "keywords": [
    "nodejs",
    "express",
    "rabbitmq",
    "event-driven",
    "rewards"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/domain/*.js",
      "src/notifications/notification.service.js",
      "src/restaurant/restaurant.service.js",
      "src/rewards/reward.repository.js",
      "src/rewards/reward.service.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    }
  }
}
